// An until whose left argument is itself an until: it looks one frame further
// than a single until does, at any horizon, so it is the case that needs the
// last frame to persist for more than one step.
let video = load("video.avi")
let a = gt(intensity(frame(video,n)),42)
let b = gt(intensity(frame(video,n)),52)
save "result" until(until(a,b),b)
