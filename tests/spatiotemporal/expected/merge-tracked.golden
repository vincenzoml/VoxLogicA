### case merge-tracked, 3 frames

### pass 1: --savetaskgraphasprogram --providecontext n
let op0(n)="merge"
let op1(n)=load(op0(n))
let op2(n)=n
let op3(n)=frame(op1(n),op2(n))
let op4(n)=intensity(op3(n))
let op5(n)=127
let op6(n)=gt(op4(n),op5(n))
let op7(n)=1
let op8(n)=tracked(op6(n),op7(n))
let op9(n)=2
let op10(n)=tracked(op6(n),op9(n))
let op11(n)=and(op8(n),op10(n))
let op12(n)=op11(inc(n))
let op13(n)=op12(inc(n))
save "merge-tracked" op13(0)
