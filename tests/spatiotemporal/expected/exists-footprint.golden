### case exists-footprint, 3 frames, 2 labels

### pass 1: --savetaskgraphasprogram --providecontext n --maxlabels 2
let op0(n,l)=l
let op1(n,l)=true
let op2(n,l)="study.nii.gz"
let op3(n,l)=load(op2(n,l))
let op4(n,l)=n
let op5(n,l)=frame(op3(n,l),op4(n,l))
let op6(n,l)=intensity(op5(n,l))
let op7(n,l)=500
let op8(n,l)=gt(op6(n,l),op7(n,l))
let op17(n,l)=and(op1(n,l),op8(inc(n),l))
let op18(n,l)=or(op8(n,l),op17(n,l))
let op19(n,l)=and(op1(n,l),op18(inc(n),l))
let op20(n,l)=or(op8(n,l),op19(n,l))
let op21(n,l)=and(op1(n,l),op20(inc(n),l))
let op22(n,l)=or(op8(n,l),op21(n,l))
let op10(n,l)=lcc(op22(n,l))
let op11(n,l)=op10(0,l)
let op12(n,l)=eq(op11(n,l),op0(n,l))
let op13(n,l)=and(op12(n,l),op8(n,l))
let op14(n,l)=op13(inc(n),l)
let op15(n,l)=and(op13(n,l),op14(n,l))
let op16(n,l)=or(op15(n,1),op15(n,2))
save "persistent" op16(0,0)
