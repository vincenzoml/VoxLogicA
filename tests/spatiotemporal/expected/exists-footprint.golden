### case exists-footprint, 3 frames, 2 labels

### pass 1: --savetaskgraphasprogram --providecontext n --maxlabels 2
let op0(n,l)=l
let op1(n,l)=tt
let op2(n,l)="study.nii.gz"
let op3(n,l)=load(op2(n,l))
let op4(n,l)=n
let op5(n,l)=frame(op3(n,l),op4(n,l))
let op6(n,l)=intensity(op5(n,l))
let op7(n,l)=500
let op8(n,l)=gt(op6(n,l),op7(n,l))
let op17(n,l)=and(op1(n,l),op8(inc(n),l))
let op18(n,l)=or(op8(n,l),op17(n,l))
let op19(n,l)=and(op1(n,l),op18(inc(n),l))
let op20(n,l)=or(op8(n,l),op19(n,l))
let op21(n,l)=and(op1(n,l),op20(inc(n),l))
let op22(n,l)=or(op8(n,l),op21(n,l))
let op10(n,l)=lcc(op22(n,l))
let op11(n,l)=op10(0,l)
let op12(n,l)=eq(op11(n,l),op0(n,l))
let op13(n,l)=and(op12(n,l),op8(n,l))
let op14(n,l)=op13(inc(n),l)
let op15(n,l)=and(op13(n,l),op14(n,l))
let op16(n,l)=bounded(op11(n,l),2,or(op15(n,1),op15(n,2)))
save "persistent" op16(0,0)
### pass 2: --savetaskgraphasprogram
let op0=0
let op1="study.nii.gz"
let op2=load(op1)
let op3=frame(op2,op0)
let op4=intensity(op3)
let op5=500
let op6=gt(op4,op5)
let op7=tt
let op8=inc(op0)
let op9=frame(op2,op8)
let op10=intensity(op9)
let op11=gt(op10,op5)
let op12=inc(op8)
let op13=frame(op2,op12)
let op14=intensity(op13)
let op15=gt(op14,op5)
let op16=inc(op12)
let op17=frame(op2,op16)
let op18=intensity(op17)
let op19=gt(op18,op5)
let op20=and(op7,op19)
let op21=or(op15,op20)
let op22=and(op7,op21)
let op23=or(op11,op22)
let op24=and(op7,op23)
let op25=or(op6,op24)
let op26=lcc(op25)
let op27=2
let op28=1
let op29=eq(op26,op28)
let op30=and(op29,op6)
let op31=and(op29,op11)
let op32=and(op30,op31)
let op33=eq(op26,op27)
let op34=and(op33,op6)
let op35=and(op33,op11)
let op36=and(op34,op35)
let op37=or(op32,op36)
let op38=bounded(op26,op27,op37)
save "persistent" op38
### pass 3: --evaluatespatiotemporal
[TIME] [warn] 'study' has 3 frame(s) and the specification looks as far as frame 3: frame 3 repeat the last one
import "stdlib2.imgql"

let op0 = "study.nii.gz"
load studyAt0 = "frames/study_0.png"
load studyAt1 = "frames/study_1.png"
load studyAt2 = "frames/study_2.png"
// frame 3 repeat frame 2: past the end the last frame persists
load studyAt3 = "frames/study_2.png"
let op2 = 0
let op3 = studyAt0
let op4 = intensity(op3)
let op5 = 500
let op6 = gt(op4,op5)
let op7 = tt
let op9 = studyAt1
let op10 = intensity(op9)
let op11 = gt(op10,op5)
let op13 = studyAt2
let op14 = intensity(op13)
let op15 = gt(op14,op5)
let op17 = studyAt3
let op18 = intensity(op17)
let op19 = gt(op18,op5)
let op20 = and(op7,op19)
let op21 = or(op15,op20)
let op22 = and(op7,op21)
let op23 = or(op11,op22)
let op24 = and(op7,op23)
let op25 = or(op6,op24)
let op26 = lcc(op25)
let op27 = 2
let op28 = 1
let op29 = eq(op26,op28)
let op30 = and(op29,op6)
let op31 = and(op29,op11)
let op32 = and(op30,op31)
let op33 = eq(op26,op27)
let op34 = and(op33,op6)
let op35 = and(op33,op11)
let op36 = and(op34,op35)
let op37 = or(op32,op36)
let op38 = op37
save "persistent.png" op38
// the bounds the existentials were unrolled to: false here means witnesses were missed
print "labels op26 within 2" max(op26) .<=. 2

### probe, pass 1: --savetaskgraphasprogram --providecontext n --probe
let op0(n,l)=l
let op1(n,l)=tt
let op2(n,l)="study.nii.gz"
let op3(n,l)=load(op2(n,l))
let op4(n,l)=n
let op5(n,l)=frame(op3(n,l),op4(n,l))
let op6(n,l)=intensity(op5(n,l))
let op7(n,l)=500
let op8(n,l)=gt(op6(n,l),op7(n,l))
let op17(n,l)=and(op1(n,l),op8(inc(n),l))
let op18(n,l)=or(op8(n,l),op17(n,l))
let op19(n,l)=and(op1(n,l),op18(inc(n),l))
let op20(n,l)=or(op8(n,l),op19(n,l))
let op21(n,l)=and(op1(n,l),op20(inc(n),l))
let op22(n,l)=or(op8(n,l),op21(n,l))
let op10(n,l)=lcc(op22(n,l))
let op11(n,l)=op10(0,l)
let op12(n,l)=eq(op11(n,l),op0(n,l))
let op13(n,l)=and(op12(n,l),op8(n,l))
let op14(n,l)=op13(inc(n),l)
let op15(n,l)=and(op13(n,l),op14(n,l))
let op16(n,l)=bounded(op11(n,l),1,op15(n,1))
print "labels of l in op11 at frame 0" max(op11(0,0))
print "labels of l in op11 at frame 1" max(op11(1,0))
print "labels of l in op11 at frame 2" max(op11(2,0))
### probe, pass 3: --evaluatespatiotemporal
[TIME] [warn] 'study' has 3 frame(s) and the specification looks as far as frame 3: frame 3 repeat the last one
import "stdlib2.imgql"

let op0 = "study.nii.gz"
load studyAt0 = "frames/study_0.png"
load studyAt1 = "frames/study_1.png"
load studyAt2 = "frames/study_2.png"
// frame 3 repeat frame 2: past the end the last frame persists
load studyAt3 = "frames/study_2.png"
let op2 = 0
let op3 = studyAt0
let op4 = intensity(op3)
let op5 = 500
let op6 = gt(op4,op5)
let op7 = tt
let op9 = studyAt1
let op10 = intensity(op9)
let op11 = gt(op10,op5)
let op13 = studyAt2
let op14 = intensity(op13)
let op15 = gt(op14,op5)
let op17 = studyAt3
let op18 = intensity(op17)
let op19 = gt(op18,op5)
let op20 = and(op7,op19)
let op21 = or(op15,op20)
let op22 = and(op7,op21)
let op23 = or(op11,op22)
let op24 = and(op7,op23)
let op25 = or(op6,op24)
let op26 = lcc(op25)
let op27 = max(op26)
print "labels of l in op11 at frame 0" op27
print "labels of l in op11 at frame 1" op27
print "labels of l in op11 at frame 2" op27
