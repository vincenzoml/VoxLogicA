### pass 3: --evaluatespatiotemporal
[TIME] [warn] 'study' has 3 frame(s) and the specification looks as far as frame 3: frame 3 repeat the last one
import "stdlib2.imgql"

let op0 = "study.nii.gz"
load studyAt0 = "frames/study_0.png"
load studyAt1 = "frames/study_1.png"
load studyAt2 = "frames/study_2.png"
// frame 3 repeat frame 2: past the end the last frame persists
load studyAt3 = "frames/study_2.png"
let op2 = 0
let op3 = studyAt0
let op4 = intensity(op3)
let op5 = 500
let op6 = gt(op4,op5)
let op7 = true
let op9 = studyAt1
let op10 = intensity(op9)
let op11 = gt(op10,op5)
let op13 = studyAt2
let op14 = intensity(op13)
let op15 = gt(op14,op5)
let op17 = studyAt3
let op18 = intensity(op17)
let op19 = gt(op18,op5)
let op20 = and(op7,op19)
let op21 = or(op15,op20)
let op22 = and(op7,op21)
let op23 = or(op11,op22)
let op24 = and(op7,op23)
let op25 = or(op6,op24)
let op26 = lcc(op25)
let op27 = 1
let op28 = eq(op26,op27)
let op29 = and(op28,op6)
let op30 = and(op28,op11)
let op31 = and(op29,op30)
let op32 = 2
let op33 = eq(op26,op32)
let op34 = and(op33,op6)
let op35 = and(op33,op11)
let op36 = and(op34,op35)
let op37 = or(op31,op36)
