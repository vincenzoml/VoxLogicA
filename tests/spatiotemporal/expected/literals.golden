### case literals, 2 frames

### pass 1: --savetaskgraphasprogram --providecontext n
let op0(n)="video.avi"
let op1(n)=load(op0(n))
let op2(n)=n
let op3(n)=frame(op1(n),op2(n))
let op4(n)=intensity(op3(n))
let op5(n)=42.5
let op6(n)=gt(op4(n),op5(n))
let op7(n)=true
let op8(n)=and(op6(n),op7(n))
save "result" op8(0)
### pass 2: --savetaskgraphasprogram
let op0=0
let op1="video.avi"
let op2=load(op1)
let op3=frame(op2,op0)
let op4=intensity(op3)
let op5=42.5
let op6=gt(op4,op5)
let op7=true
let op8=and(op6,op7)
save "result" op8
### pass 3: --evaluatespatiotemporal
import "stdlib2.imgql"

let op0 = "video.avi"
load videoAt0 = "frames/video_0.png"
load videoAt1 = "frames/video_1.png"
let op2 = 0
let op3 = videoAt0
let op4 = intensity(op3)
let op5 = 42.5
let op6 = gt(op4,op5)
let op7 = true
let op8 = and(op6,op7)
save "result.png" op8
