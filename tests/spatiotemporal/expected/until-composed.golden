### pass 3: --evaluatespatiotemporal
import "stdlib2.imgql"

let op0 = "video.avi"
load videoAt0 = "frames/video_0.png"
load videoAt1 = "frames/video_1.png"
load videoAt2 = "frames/video_2.png"
// frame 3 repeats frame 2: the unrolling can look one step past the last frame
load videoAt3 = "frames/video_2.png"
let op2 = 0
let op3 = videoAt0
let op4 = intensity(op3)
let op5 = 52
let op6 = gt(op4,op5)
let op7 = 42
let op8 = gt(op4,op7)
let op10 = videoAt1
let op11 = intensity(op10)
let op12 = gt(op11,op5)
let op13 = gt(op11,op7)
let op15 = videoAt2
let op16 = intensity(op15)
let op17 = gt(op16,op5)
let op18 = gt(op16,op7)
let op20 = videoAt3
let op21 = intensity(op20)
let op22 = gt(op21,op5)
let op23 = and(op18,op22)
let op24 = or(op17,op23)
let op25 = and(op13,op24)
let op26 = or(op12,op25)
let op27 = and(op8,op26)
let op28 = or(op6,op27)
let op29 = and(op28,op8)
save "result.png" op29
