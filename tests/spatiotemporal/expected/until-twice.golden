### case until-twice, 2 frames

### pass 1: --savetaskgraphasprogram --providecontext n
let op0(n)="video.avi"
let op1(n)=load(op0(n))
let op2(n)=n
let op3(n)=frame(op1(n),op2(n))
let op4(n)=intensity(op3(n))
let op5(n)=42
let op6(n)=gt(op4(n),op5(n))
let op7(n)=52
let op8(n)=gt(op4(n),op7(n))
let op14(n)=and(op6(n),op8(inc(n)))
let op15(n)=or(op8(n),op14(n))
let op16(n)=and(op6(n),op15(inc(n)))
let op17(n)=or(op8(n),op16(n))
let op10(n)=62
let op11(n)=gt(op4(n),op10(n))
let op18(n)=and(op6(n),op11(inc(n)))
let op19(n)=or(op11(n),op18(n))
let op20(n)=and(op6(n),op19(inc(n)))
let op21(n)=or(op11(n),op20(n))
let op13(n)=or(op17(n),op21(n))
save "result" op13(0)
