### pass 3: --evaluatespatiotemporal
import "stdlib2.imgql"

let op0 = "video.avi"
load videoAt0 = "frames/video_0.png"
load videoAt1 = "frames/video_1.png"
// frame 2 repeats frame 1: the unrolling can look one step past the last frame
load videoAt2 = "frames/video_1.png"
let op2 = 0
let op3 = videoAt0
let op4 = intensity(op3)
let op5 = 52
let op6 = gt(op4,op5)
let op7 = 42
let op8 = gt(op4,op7)
let op10 = videoAt1
let op11 = intensity(op10)
let op12 = gt(op11,op5)
let op13 = gt(op11,op7)
let op15 = videoAt2
let op16 = intensity(op15)
let op17 = gt(op16,op5)
let op18 = and(op13,op17)
let op19 = or(op12,op18)
let op20 = and(op8,op19)
let op21 = or(op6,op20)
let op22 = 62
let op23 = gt(op4,op22)
let op24 = gt(op11,op22)
let op25 = gt(op16,op22)
