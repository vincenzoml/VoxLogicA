### case until-nested, 2 frames

### pass 1: --savetaskgraphasprogram --providecontext n
let op0(n)="video.avi"
let op1(n)=load(op0(n))
let op2(n)=n
let op3(n)=frame(op1(n),op2(n))
let op4(n)=intensity(op3(n))
let op5(n)=42
let op6(n)=gt(op4(n),op5(n))
let op7(n)=52
let op8(n)=gt(op4(n),op7(n))
let op11(n)=and(op6(n),op8(inc(n)))
let op12(n)=or(op8(n),op11(n))
let op13(n)=and(op6(n),op12(inc(n)))
let op14(n)=or(op8(n),op13(n))
let op15(n)=and(op14(n),op8(inc(n)))
let op16(n)=or(op8(n),op15(n))
let op17(n)=and(op14(n),op16(inc(n)))
let op18(n)=or(op8(n),op17(n))
save "result" op18(0)
