### pass 3: --evaluatespatiotemporal
[TIME] [warn] 'video' has 2 frame(s) and the specification looks as far as frame 3: frames 2 to 3 repeat the last one
import "stdlib2.imgql"

let op0 = "video.avi"
load videoAt0 = "frames/video_0.png"
load videoAt1 = "frames/video_1.png"
// frames 2 to 3 repeat frame 1: past the end the last frame persists
load videoAt2 = "frames/video_1.png"
load videoAt3 = "frames/video_1.png"
let op2 = 0
let op3 = videoAt0
let op4 = intensity(op3)
let op5 = 52
let op6 = gt(op4,op5)
let op7 = 42
