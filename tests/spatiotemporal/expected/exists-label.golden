### case exists-label, 3 frames, 2 labels

### pass 1: --savetaskgraphasprogram --providecontext n --maxlabels 2
let op0(n,l)=l
let op1(n,l)="study.nii.gz"
let op2(n,l)=load(op1(n,l))
let op3(n,l)=n
let op4(n,l)=frame(op2(n,l),op3(n,l))
let op5(n,l)=intensity(op4(n,l))
let op6(n,l)=500
let op7(n,l)=gt(op5(n,l),op6(n,l))
let op8(n,l)=tracked(op7(n,l),op0(n,l))
let op9(n,l)=op8(inc(n),l)
let op10(n,l)=and(op8(n,l),op9(n,l))
let op11(n,l)=or(op10(n,1),op10(n,2))
save "persistent" op11(0,0)
### pass 2: --savetaskgraphasprogram
let op0=0
let op1=1
let op2="study.nii.gz"
let op3=load(op2)
let op4=frame(op3,op0)
let op5=intensity(op4)
let op6=500
let op7=gt(op5,op6)
let op8=tracked(op7,op1)
let op9=inc(op0)
let op10=frame(op3,op9)
let op11=intensity(op10)
let op12=gt(op11,op6)
let op13=tracked(op12,op1)
let op14=and(op8,op13)
let op15=2
let op16=tracked(op7,op15)
let op17=tracked(op12,op15)
let op18=and(op16,op17)
let op19=or(op14,op18)
save "persistent" op19
### pass 3: --evaluatespatiotemporal
import "stdlib2.imgql"

