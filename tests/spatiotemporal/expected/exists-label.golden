### case exists-label, 3 frames, 2 labels

### pass 1: --savetaskgraphasprogram --providecontext n --maxlabels 2
let op0(n,l)=l
let op1(n,l)="study.nii.gz"
let op2(n,l)=load(op1(n,l))
let op3(n,l)=n
let op4(n,l)=frame(op2(n,l),op3(n,l))
let op5(n,l)=intensity(op4(n,l))
let op6(n,l)=500
let op7(n,l)=gt(op5(n,l),op6(n,l))
let op8(n,l)=lcc(op7(n,l))
let op9(n,l)=op8(0,l)
let op14(n,l)=eq(lcc(op7(0,l)),op0(n,l))
let op15(n,l)=through(op14(n,l),op7(1,l))
let op16(n,l)=through(op15(n,l),op7(2,l))
let op17(n,l)=select(n,op14(n,l),op15(n,l),op16(n,l))
let op11(n,l)=op17(inc(n),l)
let op12(n,l)=and(op17(n,l),op11(n,l))
let op13(n,l)=bounded(op9(n,l),2,or(op12(n,1),op12(n,2)))
save "persistent" op13(0,0)
### pass 2: --savetaskgraphasprogram
let op0=0
let op1="study.nii.gz"
let op2=load(op1)
let op3=frame(op2,op0)
let op4=intensity(op3)
let op5=500
let op6=gt(op4,op5)
let op7=lcc(op6)
let op8=2
let op9=1
let op10=eq(op7,op9)
let op11=frame(op2,op9)
let op12=intensity(op11)
let op13=gt(op12,op5)
let op14=through(op10,op13)
let op15=frame(op2,op8)
let op16=intensity(op15)
let op17=gt(op16,op5)
let op18=through(op14,op17)
let op19=select(op0,op10,op14,op18)
let op20=inc(op0)
let op21=select(op20,op10,op14,op18)
let op22=and(op19,op21)
let op23=eq(op7,op8)
let op24=through(op23,op13)
let op25=through(op24,op17)
let op26=select(op0,op23,op24,op25)
let op27=select(op20,op23,op24,op25)
let op28=and(op26,op27)
let op29=or(op22,op28)
let op30=bounded(op7,op8,op29)
save "persistent" op30
### pass 3: --evaluatespatiotemporal
import "stdlib2.imgql"

let op0 = "study.nii.gz"
load studyAt0 = "frames/study_0.png"
load studyAt1 = "frames/study_1.png"
load studyAt2 = "frames/study_2.png"
let op2 = 0
let op3 = studyAt0
let op4 = intensity(op3)
let op5 = 500
let op6 = gt(op4,op5)
let op7 = lcc(op6)
let op8 = 2
let op9 = 1
let op10 = eq(op7,op9)
let op11 = studyAt1
let op12 = intensity(op11)
let op13 = gt(op12,op5)
let op14 = through(op10,op13)
let op15 = studyAt2
let op16 = intensity(op15)
let op17 = gt(op16,op5)
let op18 = through(op14,op17)
let op19 = op10
let op21 = op14
let op22 = and(op19,op21)
let op23 = eq(op7,op8)
let op24 = through(op23,op13)
let op25 = through(op24,op17)
let op26 = op23
let op27 = op24
let op28 = and(op26,op27)
let op29 = or(op22,op28)
let op30 = op29
save "persistent.png" op30
// the bounds the existentials were unrolled to: false here means witnesses were missed
print "labels op7 within 2" max(op7) .<=. 2

### probe, pass 1: --savetaskgraphasprogram --providecontext n --probe
let op0(n,l)=l
let op1(n,l)="study.nii.gz"
let op2(n,l)=load(op1(n,l))
let op3(n,l)=n
let op4(n,l)=frame(op2(n,l),op3(n,l))
let op5(n,l)=intensity(op4(n,l))
let op6(n,l)=500
let op7(n,l)=gt(op5(n,l),op6(n,l))
let op8(n,l)=lcc(op7(n,l))
let op9(n,l)=op8(0,l)
let op14(n,l)=eq(lcc(op7(0,l)),op0(n,l))
let op15(n,l)=through(op14(n,l),op7(1,l))
let op16(n,l)=through(op15(n,l),op7(2,l))
let op17(n,l)=select(n,op14(n,l),op15(n,l),op16(n,l))
let op11(n,l)=op17(inc(n),l)
let op12(n,l)=and(op17(n,l),op11(n,l))
let op13(n,l)=bounded(op9(n,l),1,op12(n,1))
print "labels of l in op9 at frame 0" max(op9(0,0))
print "labels of l in op9 at frame 1" max(op9(1,0))
print "labels of l in op9 at frame 2" max(op9(2,0))
### probe, pass 3: --evaluatespatiotemporal
import "stdlib2.imgql"

let op0 = "study.nii.gz"
load studyAt0 = "frames/study_0.png"
load studyAt1 = "frames/study_1.png"
load studyAt2 = "frames/study_2.png"
let op2 = 0
let op3 = studyAt0
let op4 = intensity(op3)
let op5 = 500
let op6 = gt(op4,op5)
let op7 = lcc(op6)
let op8 = max(op7)
print "labels of l in op9 at frame 0" op8
print "labels of l in op9 at frame 1" op8
print "labels of l in op9 at frame 2" op8
